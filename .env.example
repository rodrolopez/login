# Copy to .env and replace every placeholder with local-only values.
PORT=3005

# Exact browser origins allowed to call the API cross-origin; comma-separated, no paths or wildcard.
CORS_ALLOWED_ORIGINS=

# Development services
POSTGRES_DB=identity_dev
POSTGRES_USER=identity_dev
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5436
PGHOST=127.0.0.1
PGPORT=5436
PGDATABASE=identity_dev
PGUSER=identity_dev
PGPASSWORD=replace-with-a-unique-local-password
PGPOOL_MAX=10

REDIS_PASSWORD=replace-with-a-different-local-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Required to enable TOTP MFA; generate with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# OIDC development defaults: issuer is http://127.0.0.1:3005/oidc.
# Signing, cookie, and confidential-client secrets are generated at runtime if omitted.
# For stable local integrations, supply fresh values in the ignored .env file.
OIDC_ISSUER=
OIDC_CONFIDENTIAL_CLIENT_SECRET=
# Separate confidential development client for examples/bff-client; generate locally with:
# openssl rand -base64 48
OIDC_BFF_CLIENT_SECRET=
OIDC_COOKIE_KEYS=
OIDC_JWKS=
# Production must also provide a JSON array of registered clients through a secret manager.
OIDC_CLIENTS=

# Google sign-in is disabled until all three settings are configured.
# For local development use the exact callback URI registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback

# Disposable integration-test services (Compose profile: test-infra)
TEST_PGDATABASE=identity_api_test
TEST_PGUSER=identity_test
TEST_PGPASSWORD=replace-with-a-test-only-password
TEST_PGHOST=127.0.0.1
TEST_PGPORT=15433
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=16380
TEST_REDIS_DB=15
TEST_REDIS_PASSWORD=replace-with-a-test-only-password
